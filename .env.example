# Required: token from @BotFather
BOT_TOKEN=

# docker compose only: password of the bundled PostgreSQL
POSTGRES_PASSWORD=

# Database. SQLite for local development, PostgreSQL in production.
# DATABASE_URL=postgresql://napominator:napominator@postgres:5432/napominator
DATABASE_URL=sqlite:///./napominator.db

# Logging: DEBUG | INFO | WARNING | ERROR; format: console | json
LOG_LEVEL=INFO
LOG_FORMAT=console

# Comma-separated Telegram user ids allowed to use /admin
ADMIN_IDS=

# Delivery engine
DISPATCHER_POLL_SECONDS=5
DISPATCHER_LEASE_SECONDS=60

# Optional: webhook mode (HTTPS + secret). Leave empty to use long polling.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional: Redis for FSM storage (default is in-memory)
REDIS_URL=

# Optional: LLM fallback parser (off by default; message text leaves your server when enabled)
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=

# Optional: error reporting
SENTRY_DSN=
